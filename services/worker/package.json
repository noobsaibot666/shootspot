{
  "name": "@shootspot/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:int": "vitest run test --testTimeout=60000 --hookTimeout=120000",
    "start": "tsx src/main.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@sentry/node": "^11.8.0",
    "@shootspot/shared": "workspace:*",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@shootspot/api": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
