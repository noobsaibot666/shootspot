# Copy to .env for local development (matches infra/local/docker-compose.yml).
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://127.0.0.1:4000
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgres://shootspot:shootspot-dev@127.0.0.1:55432/shootspot
# Development only. Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=ShootSpot <no-reply@shootspot.local>
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=shootspot-dev
S3_SECRET_ACCESS_KEY=shootspot-dev-secret
S3_BUCKET_QUARANTINE=shootspot-quarantine
S3_BUCKET_PUBLIC=shootspot-public
