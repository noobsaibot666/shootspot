# Copy to .env for local development (matches infra/local/docker-compose.yml).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://shootspot:shootspot-dev@127.0.0.1:55432/shootspot
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=shootspot-dev
S3_SECRET_ACCESS_KEY=shootspot-dev-secret
S3_BUCKET_QUARANTINE=shootspot-quarantine
S3_BUCKET_PUBLIC=shootspot-public
