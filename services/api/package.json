{
  "name": "@shootspot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "node-pg-migrate --migrations-dir migrations --envPath .env",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:int": "vitest run test --testTimeout=60000 --hookTimeout=120000",
    "owner:grant": "tsx --env-file-if-exists=.env scripts/grant-owner.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@better-auth/expo": "1.7.10",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@shootspot/shared": "workspace:*",
    "better-auth": "^1.7.10",
    "fastify": "^5.12.7",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.1.2",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "dotenv": "^18.0.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "exports": {
    "./testing": "./src/testing.ts"
  }
}
