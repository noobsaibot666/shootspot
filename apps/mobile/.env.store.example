# Copy to apps/mobile/.env.store (gitignored) for local Play Store builds:
#   powershell -File tools/android-local.ps1 -Store
# These values override apps/mobile/.env for that build only.
EXPO_PUBLIC_API_URL=https://shootspot-api.expose-u.com
# From expo.dev → @expose.u/shootspot → Environment variables (production).
EXPO_PUBLIC_SENTRY_DSN=
# Optional: falls back to the value in apps/mobile/.env.
# GOOGLE_MAPS_ANDROID_KEY=

# Upload keystore, downloaded from EAS (`eas credentials -p android` → production → Download).
# Keep the file outside the repo, e.g. in %USERPROFILE%\.shootspot\.
SHOOTSPOT_UPLOAD_STORE_FILE=C:\Users\<you>\.shootspot\upload.jks
SHOOTSPOT_UPLOAD_STORE_PASSWORD=
SHOOTSPOT_UPLOAD_KEY_ALIAS=
SHOOTSPOT_UPLOAD_KEY_PASSWORD=
