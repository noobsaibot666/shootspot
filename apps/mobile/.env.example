# Copy to apps/mobile/.env (gitignored). Restart `expo start` after changing.
# Phone testing against this PC: use the PC's LAN address (phone and PC on the same Wi-Fi).
EXPO_PUBLIC_API_URL=http://192.168.178.63:4000
# Against the NAS (LAN):
# EXPO_PUBLIC_API_URL=http://172.16.1.1:4400

# Only needed for Android builds with a working map (HANDWORK 3.4). Set as an EAS secret for cloud builds.
# GOOGLE_MAPS_ANDROID_KEY=
