{
  "expo": {
    "name": "ShootSpot",
    "slug": "shootspot",
    "scheme": "shootspot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.exposeu.shootspot",
      "appleTeamId": "RD7UU4Z3D2",
      "buildNumber": "9",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.exposeu.shootspot"]
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSCameraUsageDescription": "ShootSpot uses the camera to photograph locations you scout.",
        "NSLocationWhenInUseUsageDescription": "ShootSpot uses your location to pin the place you photograph and to show locations near you. You can always place the pin manually instead."
      }
    },
    "android": {
      "package": "com.shootspot.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FF1E00",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ShootSpot uses your location to pin the place you photograph and to show locations near you. You can always place the pin manually instead."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ShootSpot lets you import location photos you took. Their location and time prefill the pin; that data never leaves your phone.",
          "cameraPermission": "ShootSpot uses the camera to photograph locations you scout.",
          "microphonePermission": false
        }
      ],
      ["@sentry/react-native/expo", { "url": "https://de.sentry.io/", "disableAutoUpload": true }],
      "expo-router",
      "expo-secure-store",
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "43d5bfac-52db-4815-999f-6cd2336d405b"
      }
    },
    "owner": "expose.u"
  }
}
