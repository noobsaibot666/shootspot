# NAS stack settings. On the NAS this file is runtime/compose/.env, owned by root, mode 600.
# Generate each secret ON THE NAS with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
# NAS address on the home network (phones on Wi-Fi reach this; 172.16.1.1 is the direct PC link only)
LAN_IP=192.168.178.146
API_PORT=4400
ADMIN_PORT=4401
S3_PORT=4402
MAIL_UI_PORT=4403
TAG=latest

POSTGRES_PASSWORD=
S3_ACCESS_KEY_ID=shootspot
S3_SECRET_ACCESS_KEY=
S3_BUCKET_QUARANTINE=shootspot-quarantine
S3_BUCKET_PUBLIC=shootspot-public
AUTH_SECRET=

# Used by the API (env_file) as well
PUBLIC_API_URL=http://192.168.178.146:4400
TRUSTED_ORIGINS=http://192.168.178.146:4401
MAIL_FROM=ShootSpot <no-reply@shootspot.local>
# Behind the Cloudflare Tunnel later: CLIENT_IP_HEADER=cf-connecting-ip
DELETION_GRACE_DAYS=7
