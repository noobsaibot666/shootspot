# NAS stack settings. On the NAS this file is runtime/compose/.env, owned by root, mode 600.
# Generate each secret ON THE NAS with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
# NAS address on the home network (phones on Wi-Fi reach this; 172.16.1.1 is the direct PC link only)
LAN_IP=192.168.178.146
API_PORT=4400
ADMIN_PORT=4401
S3_PORT=4402
MAIL_UI_PORT=4403
TAG=latest

POSTGRES_PASSWORD=
S3_ACCESS_KEY_ID=shootspot
S3_SECRET_ACCESS_KEY=
S3_BUCKET_QUARANTINE=shootspot-quarantine
S3_BUCKET_PUBLIC=shootspot-public
AUTH_SECRET=

# Used by the API (env_file) as well
PUBLIC_API_URL=http://192.168.178.146:4400
TRUSTED_ORIGINS=http://192.168.178.146:4401
# Admin web accounts (comma-separated). The owner role in the database is not enough on its own.
ADMIN_EMAILS=alanxalves@me.com
MAIL_FROM=ShootSpot <no-reply@shootspot.local>
# Public through the Cloudflare Tunnel (D-33), set all three together:
# PUBLIC_API_URL=https://shootspot-api.expose-u.com
# S3_PUBLIC_ENDPOINT=https://shootspot-media.expose-u.com
# CLIENT_IP_HEADER=cf-connecting-ip
# Store review account (D-34): set both only while a review is open, then remove them.
# REVIEW_EMAIL=review@expose-u.com
# REVIEW_CODE=<6 random digits, given only to Apple/Google in the review notes>

DELETION_GRACE_DAYS=7

# Backups (D-27): nightly at BACKUP_AT, NAS local time
BACKUP_AT=03:15
TZ=Europe/Berlin
# Off-site to Backblaze B2 EU, filled in once the bucket exists (HANDWORK 2.5). Leave empty until then.
# RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/<bucket>/shootspot
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Email (D-26): Brevo SMTP once the domain is verified (HANDWORK 3.2). Empty = Mailpit (devmail).
# SMTP_URL=smtp://<brevo-login>:<smtp-key>@smtp-relay.brevo.com:587
# MAIL_FROM=ShootSpot <no-reply@your-domain>

# Alert emails go to every owner account (worker check every 30 min)
# Crash reports (D-24): Sentry EU DSNs, optional (HANDWORK 3.7)
SENTRY_DSN_API=
SENTRY_DSN_WORKER=
