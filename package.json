{
  "name": "shootspot",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "\u003e=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:infra": "docker compose -f infra/local/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/local/docker-compose.yml down",
    "dev:api": "pnpm --filter @shootspot/api dev",
    "db:migrate": "pnpm --filter @shootspot/api migrate up",
    "test:int": "pnpm -r --if-present --workspace-concurrency=1 test:int",
    "dev:worker": "pnpm --filter @shootspot/worker dev",
    "dev:admin": "pnpm --filter @shootspot/admin dev"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
